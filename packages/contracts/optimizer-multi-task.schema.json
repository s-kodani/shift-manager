{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shift-planner.invalid/contracts/optimizer-multi-task-v1",
  "title": "A1 multi-task input: integer-minute reference, explicit settings and fixed versions",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "tenantId",
    "teamId",
    "month",
    "inputVersion",
    "settingsVersion",
    "jobId",
    "attempt",
    "slotMinutes",
    "priority",
    "weekStart",
    "breakRule",
    "patterns",
    "staff",
    "demand",
    "history",
    "mode",
    "capacityScale",
    "tasks",
    "roles",
    "roleRequirements",
    "transitions",
    "events",
    "locks",
    "exceptions",
    "published"
  ],
  "properties": {
    "schemaVersion": {
      "const": "multi-task-v1"
    },
    "tenantId": {
      "type": "string",
      "minLength": 1
    },
    "teamId": {
      "type": "string",
      "minLength": 1
    },
    "month": {
      "type": "string",
      "pattern": "^20[0-9]{2}-(0[1-9]|1[0-2])$"
    },
    "inputVersion": {
      "type": "integer",
      "minimum": 1
    },
    "settingsVersion": {
      "type": "integer",
      "minimum": 1
    },
    "jobId": {
      "type": "string",
      "minLength": 1
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "slotMinutes": {
      "enum": [
        30,
        60
      ]
    },
    "priority": {
      "enum": [
        "coverage",
        "preference"
      ]
    },
    "weekStart": {
      "type": "integer",
      "minimum": 0,
      "maximum": 6
    },
    "breakRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "basis",
        "threshold",
        "requiredMinutes",
        "afterStart",
        "beforeEnd"
      ],
      "properties": {
        "basis": {
          "enum": [
            "elapsed",
            "worked"
          ]
        },
        "threshold": {
          "$ref": "#/$defs/minute"
        },
        "requiredMinutes": {
          "$ref": "#/$defs/aligned"
        },
        "afterStart": {
          "$ref": "#/$defs/minute"
        },
        "beforeEnd": {
          "$ref": "#/$defs/minute"
        }
      }
    },
    "patterns": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "start",
          "end",
          "breakKind"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "start": {
            "$ref": "#/$defs/aligned"
          },
          "end": {
            "$ref": "#/$defs/aligned"
          },
          "breakKind": {
            "enum": [
              "auto",
              "fixed"
            ]
          },
          "fixedBreak": {
            "$ref": "#/$defs/interval"
          }
        }
      }
    },
    "staff": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "contract",
          "rules",
          "unavailable",
          "preferences",
          "skills",
          "roleIds"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "contract": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "weekdays",
              "start",
              "end"
            ],
            "properties": {
              "weekdays": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 6
                }
              },
              "start": {
                "$ref": "#/$defs/aligned"
              },
              "end": {
                "$ref": "#/$defs/aligned"
              }
            }
          },
          "rules": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "dailyMax",
                "weeklyMax",
                "monthlyMin",
                "monthlyMax",
                "minDays",
                "minOff",
                "maxConsecutive"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "dailyMax": {
                  "$ref": "#/$defs/minute"
                },
                "weeklyMax": {
                  "$ref": "#/$defs/monthMinutes"
                },
                "monthlyMin": {
                  "$ref": "#/$defs/monthMinutes"
                },
                "monthlyMax": {
                  "$ref": "#/$defs/monthMinutes"
                },
                "minDays": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 31
                },
                "minOff": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 31
                },
                "maxConsecutive": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 31
                }
              }
            }
          },
          "unavailable": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "date",
                "start",
                "end"
              ],
              "properties": {
                "date": {
                  "$ref": "#/$defs/date"
                },
                "start": {
                  "$ref": "#/$defs/minute"
                },
                "end": {
                  "$ref": "#/$defs/minute"
                }
              }
            }
          },
          "preferences": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "date",
                "kind"
              ],
              "properties": {
                "date": {
                  "$ref": "#/$defs/date"
                },
                "kind": {
                  "enum": [
                    "work",
                    "off",
                    "pattern",
                    "window"
                  ]
                },
                "patternId": {
                  "type": "string"
                },
                "start": {
                  "$ref": "#/$defs/aligned"
                },
                "end": {
                  "$ref": "#/$defs/aligned"
                }
              }
            }
          },
          "skills": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "taskId",
                "level",
                "capacity"
              ],
              "properties": {
                "taskId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "level": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 10000
                },
                "capacity": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 10000
                }
              }
            },
            "maxItems": 5
          },
          "roleIds": {
            "type": "array",
            "uniqueItems": true,
            "maxItems": 2,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        }
      }
    },
    "demand": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "date",
          "start",
          "end",
          "direct",
          "calculated",
          "taskId"
        ],
        "properties": {
          "date": {
            "$ref": "#/$defs/date"
          },
          "start": {
            "$ref": "#/$defs/aligned"
          },
          "end": {
            "$ref": "#/$defs/aligned"
          },
          "direct": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 5000000
          },
          "calculated": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 5000000
          },
          "taskId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        }
      }
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "staffId",
          "date",
          "workedMinutes"
        ],
        "properties": {
          "staffId": {
            "type": "string"
          },
          "date": {
            "$ref": "#/$defs/date"
          },
          "workedMinutes": {
            "$ref": "#/$defs/minute"
          }
        }
      }
    },
    "mode": {
      "enum": [
        "draft",
        "reallocation"
      ]
    },
    "capacityScale": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "minimumLevel",
          "minimumMinutes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "kind": {
            "enum": [
              "general",
              "dedicated"
            ]
          },
          "minimumLevel": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          },
          "minimumMinutes": {
            "$ref": "#/$defs/minute"
          }
        }
      },
      "maxItems": 5,
      "minItems": 1
    },
    "roles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "allowedTasks"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "allowedTasks": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "maxItems": 5
          }
        }
      },
      "maxItems": 2
    },
    "transitions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fromTaskId",
          "toTaskId",
          "minutes"
        ],
        "properties": {
          "fromTaskId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "toTaskId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "minutes": {
            "$ref": "#/$defs/minute"
          }
        }
      },
      "maxItems": 20
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "date",
          "start",
          "end",
          "kind",
          "staffIds"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "date": {
            "$ref": "#/$defs/date"
          },
          "start": {
            "$ref": "#/$defs/minute"
          },
          "end": {
            "$ref": "#/$defs/minute"
          },
          "kind": {
            "enum": [
              "training",
              "meeting"
            ]
          },
          "staffIds": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        }
      }
    },
    "roleRequirements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "date",
          "start",
          "end",
          "taskId",
          "roleId",
          "minimum",
          "ratioNumerator",
          "ratioDenominator",
          "rounding",
          "priority"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "date": {
            "$ref": "#/$defs/date"
          },
          "start": {
            "$ref": "#/$defs/aligned"
          },
          "end": {
            "$ref": "#/$defs/aligned"
          },
          "taskId": {
            "type": [
              "string",
              "null"
            ]
          },
          "roleId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "minimum": {
            "type": "integer",
            "minimum": 0,
            "maximum": 500
          },
          "ratioNumerator": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          },
          "ratioDenominator": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000
          },
          "rounding": {
            "enum": [
              "ceil",
              "floor"
            ]
          },
          "priority": {
            "enum": [
              "first",
              "same"
            ]
          }
        }
      }
    },
    "locks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "staffId",
          "date",
          "parts",
          "shift"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "staffId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "date": {
            "$ref": "#/$defs/date"
          },
          "parts": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "pattern",
                "time",
                "break"
              ]
            }
          },
          "shift": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/$defs/shift"
              }
            ]
          }
        }
      }
    },
    "exceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "lockId",
          "staffId",
          "date",
          "start",
          "end",
          "reason"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "lockId": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 128
          },
          "staffId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "date": {
            "$ref": "#/$defs/date"
          },
          "start": {
            "$ref": "#/$defs/minute"
          },
          "end": {
            "$ref": "#/$defs/minute"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        }
      }
    },
    "published": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "staffId",
          "date",
          "shift"
        ],
        "properties": {
          "staffId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "date": {
            "$ref": "#/$defs/date"
          },
          "shift": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/$defs/shift"
              }
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "minute": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1440
    },
    "aligned": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1440,
      "multipleOf": 30
    },
    "monthMinutes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 44640
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "interval": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "$ref": "#/$defs/aligned"
      }
    },
    "shift": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "patternId",
        "start",
        "end",
        "breakKind",
        "break",
        "workedMinutes",
        "cancelled"
      ],
      "properties": {
        "patternId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "start": {
          "$ref": "#/$defs/aligned"
        },
        "end": {
          "$ref": "#/$defs/aligned"
        },
        "breakKind": {
          "enum": [
            "auto",
            "fixed"
          ]
        },
        "break": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/interval"
            }
          ]
        },
        "workedMinutes": {
          "$ref": "#/$defs/minute"
        },
        "cancelled": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/interval"
          },
          "maxItems": 2
        }
      }
    },
    "assignment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "staffId",
        "date",
        "shift",
        "blocks"
      ],
      "properties": {
        "staffId": {
          "type": "string"
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "shift": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/shift"
            }
          ]
        },
        "blocks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "start",
              "end",
              "taskId",
              "roleId"
            ],
            "properties": {
              "start": {
                "$ref": "#/$defs/aligned"
              },
              "end": {
                "$ref": "#/$defs/aligned"
              },
              "taskId": {
                "type": "string"
              },
              "roleId": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "roleIntervals": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "start",
              "end",
              "roleId"
            ],
            "properties": {
              "start": {
                "$ref": "#/$defs/minute"
              },
              "end": {
                "$ref": "#/$defs/minute"
              },
              "roleId": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
