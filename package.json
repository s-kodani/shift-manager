{
  "name": "shift-manager",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run build:app && wrangler dev --config infra/wrangler.jsonc",
    "types": "npm run build:app && wrangler types apps/api/worker-configuration.d.ts --config infra/wrangler.jsonc --strict-vars=false",
    "contracts:generate": "node scripts/generate-contracts.mjs",
    "typecheck": "node scripts/generate-contracts.mjs --check && tsc --noEmit && npm run typecheck:app",
    "test": "vitest run",
    "test:client": "vitest run --config vitest.client.config.ts",
    "db:migrate": "wrangler d1 migrations apply DB --local --config infra/wrangler.jsonc",
    "build": "wrangler deploy --dry-run --env=\"\" --config infra/wrangler.jsonc --outdir dist",
    "check": "npm run build:app && npm run typecheck && npm run test:ops && npm test && npm run test:client && npm run build && npm run build:operator",
    "build:poc": "npm run build:app && wrangler deploy --dry-run --env poc --config infra/wrangler.jsonc --outdir dist/poc",
    "test:optimizer": "node scripts/check-python-lock.mjs && cd services/optimizer && uv run --frozen ruff check optimizer tests ../../scripts/build-optimizer-runtime.py ../../scripts/backup-catalog.py ../../scripts/backup-schema-upgrade.py ../../scripts/backup-archive.py ../../scripts/capture-optimizer-model.py ../../scripts/extract-local-input-order.py && uv run --frozen pytest -q",
    "security:install": "node scripts/security/install.mjs && uv sync --project tools/security --frozen --python 3.11",
    "security:check": "node scripts/security/check.mjs",
    "build:app": "vite build --config apps/web/product/vite.config.ts && npm run build:reset",
    "typecheck:app": "tsc --noEmit --project apps/web/product/tsconfig.json",
    "dev:ui": "npm run build:app && wrangler dev apps/api/src/local-ui-worker.ts --config infra/wrangler.jsonc --ip 127.0.0.1 --port 8787",
    "ui:fixture": "node scripts/local-ui-fixture.mjs",
    "test:ops": "node --test tests/ops/*.test.mjs",
    "ops": "node scripts/operations.mjs",
    "types:backup": "node scripts/generate-backup-types.mjs",
    "build:backup": "wrangler deploy --dry-run --config infra/backup-monitor.jsonc --outdir dist/backup-monitor",
    "operator": "node scripts/operator.mjs",
    "maintenance": "node scripts/maintenance.mjs",
    "types:operator": "node scripts/generate-operator-types.mjs",
    "build:operator": "wrangler deploy --dry-run --config infra/operator-provision.jsonc --outdir dist/operator",
    "test:cancellation-native": "node scripts/run-cancellation-boundaries.mjs",
    "test:compute-large-native": "node scripts/run-large-compute-native.mjs",
    "test:compute-bounded-native": "node scripts/run-bounded-compute-native.mjs",
    "test:compute-bounded-http-native": "node scripts/run-bounded-http-compute-native.mjs",
    "test:compute-registered-native": "node scripts/run-registered-compute-native.mjs",
    "test:compute-http-native": "node scripts/run-http-compute-native.mjs",
    "test:compute-saved-native": "node scripts/run-saved-candidate-native.mjs",
    "dev:bounded-sdk": "npm run build:app && node scripts/run-bounded-sdk-local.mjs",
    "test:compute-order-native": "node scripts/compare-input-order-native.mjs",
    "test:compute-budget-native": "node scripts/compare-input-order-native.mjs --budget-timing",
    "test:compute-presolve-native": "node scripts/compare-input-order-native.mjs --budget-comparison",
    "test:compute-run-bounds-native": "node scripts/compare-input-order-native.mjs --run-bound-comparison",
    "test:compute-solution-transfer-native": "node scripts/compare-input-order-native.mjs --solution-transfer-comparison",
    "test:compute-quality-native": "node scripts/run-operational-quality-native.mjs",
    "build:reset": "vite build --config apps/web/reset.vite.config.ts",
    "remote": "node scripts/remote.mjs",
    "check:public": "node scripts/check-public-source.mjs",
    "licenses:inventory": "node scripts/license-inventory.mjs"
  },
  "dependencies": {
    "@cloudflare/containers": "0.3.7",
    "@radix-ui/react-alert-dialog": "1.2.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-tabs": "1.2.1",
    "@radix-ui/react-toast": "1.3.1",
    "better-auth": "1.7.7",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "hono": "4.13.16",
    "lucide-react": "1.57.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.6"
  },
  "overrides": {
    "zod": "$zod",
    "undici": "7.30.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.8.0",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0",
    "wrangler": "4.160.1"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/s-kodani/shift-manager.git"
  },
  "bugs": {
    "url": "https://github.com/s-kodani/shift-manager/issues"
  }
}
